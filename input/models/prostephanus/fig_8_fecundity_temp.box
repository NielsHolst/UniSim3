#using cmbp
Simulation sim {
  .steps = ./temperature[steps]
  SequenceByStep temperature {
    .min = 10
    .max = 35
    .by  = 0.1
  }  
  Fecundity fecundity {
    .T = temperature[value]
  }
  OutputR {
    PageR {
      .xAxis = temperature[value]
      .width = 7
      .height =3.5
      PlotR {
        .ports = fecundity[value]
        .ggplot = "xlim(15,35) + labs(x='Temperature', y='Total eggs laid per capita')" 
      }
    }
  }
}

