#using cmbp
Simulation sim {
  .iterations = scenarios[iterations]
  .steps = 160
  Scenarios scenarios {
    .fileName = "fig_8_fecundity_age_scenarios.txt"
  }
  Stage eggLaying {
    .initial = 1
    .growthFactor = fecundity[value]
    .duration = 50
    .k = 4  
    Fecundity fecundity {
      .T = scenarios[Temperature]
    }
  }
  OutputR {
    PageR {
      .width = 7
      .height =3.5
      PlotR {
        .ports = eggLaying[outflow]
        .layout = "merged"
        .ggplot = "labs(x='Age (days)', y='Eggs laid per capita per day', colour='Temperature') + 
                  scale_colour_discrete(labels = c('1' = '20 C','2' = '25 C','3' = '27 C','4' = '30 C')) +
                  guides(colour = guide_legend(reverse=TRUE))"
      }
    }
  }
}

