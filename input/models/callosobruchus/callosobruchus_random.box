#using callosobruchus
Simulation sim {
  .steps = 90
  .iterations = 30
  .silent = TRUE
  Box settings {
    &temperature = 30
    &adultLifetime = 7 // days
    &sexRatio = 0.5
    &initialAdults = 20
  }
  RandomPreferences pref {
  }
  // FixedPreferences pref {
    // .p0 = 0.7
    // .p1 = 0.2
  // }
  Calendar calendar {
  }
  Box store {
    Stock stock {  
      .size = 0.1 //kg
      .undamagedTo1 = ovipositionDistribution[p0To1]
      .undamagedTo2 = ovipositionDistribution[p0To2]
    }
    LobryRossoFlandrois time {
      .T = settings[temperature]
      .maximum = 0.0456
      .Tmin = 8.8
      .Topt = 34.0
      .Tmax = 41.2
    }
    Stage parasitised1 {
      .inflow = ovipositionDistribution[p0To1]
      .timeStep = ../time[step]
      .duration = 1.
      .phaseOutflowProportion = if (.[value] > 0) then ovipositionDistribution[p1To2] / .[value] else 0.
    }
    Stage parasitised2 {
      .inflow = ovipositionDistribution[p0To2]
      .timeStep = ../time[step]
      .duration = 1.
      .phaseInflow = ../parasitised1[phaseOutflow]
    }
  }
  Box callosobruchus {
    Stage adult {
      .initial = settings[initialAdults]
      .inflow = store/parasitised1[outflow] + 2*store/parasitised2[outflow]
      .timeStep = 1
      .duration = settings[adultLifetime] 
    }
    Stage oviposition {
      .initial = ../adult[initial]
      .inflow = ../adult[inflow]
      .timeStep = ../adult[timeStep]
      .duration = ../adult[duration]
      .growthFactor = ./fecundity[value]*settings[sexRatio]
      Fecundity fecundity {
        .temperature = settings[temperature]
      }
    }
    OvipositionDistribution ovipositionDistribution {
      .numEggsLaid = callosobruchus/oviposition[outflow]
      .p0 = pref[p0]
      .p1 = pref[p1]
      .p2 = pref[p2]
      .parasitised0 = store/stock[seedsUndamaged]
      .parasitised1 = store/parasitised1[value]
      .parasitised2 = store/parasitised2[value]
    }
  }
  OutputR {
    .scripts = "callosobruchus_random_show.R"
    OutputText {
      .ports = callosobruchus/adult[value] | callosobruchus/adult[outflowTotal] | stock[output::*] | stock[size] | ovipositionDistribution[numEggsLaid]
    }
  }
}